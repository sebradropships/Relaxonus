# Copy to .env.local and fill in. Never commit .env.local.
#
# Storefront API PUBLIC access token, from Shopify admin:
#   Sales channels -> Headless -> your storefront -> Storefront API
# This token is designed to be publicly readable and is scoped to
# unauthenticated storefront reads only.
#
# Do NOT put an Admin API token (shpat_...) in this file or anywhere in
# this repo. Admin tokens grant full access to orders and customer data
# and must never reach a storefront.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_PRODUCT_HANDLE=
