# Copy to .env.local and fill in. Never commit .env.local.
#
# ---------------------------------------------------------------------------
# API ACCESS — never customer-facing
# ---------------------------------------------------------------------------
# SHOPIFY_STORE_DOMAIN is the host of the Storefront GraphQL endpoint and
# nothing else. It is used ONLY to build
# https://<domain>/api/<version>/graphql.json in lib/shopify/client.ts.
# It must never be linked to, redirected to, or used as a canonical URL:
# that would send shoppers to the Shopify Online Store instead of this
# storefront.
#
# Storefront API PUBLIC access token, from Shopify admin:
#   Sales channels -> Headless -> your storefront -> Storefront API
# This token is designed to be publicly readable and is scoped to
# unauthenticated storefront reads only.
#
# Do NOT put an Admin API token (shpat_...) in this file or anywhere in
# this repo. Admin tokens grant full access to orders and customer data
# and must never reach a storefront.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_PRODUCT_HANDLE=

# ---------------------------------------------------------------------------
# CUSTOMER-FACING — never sent to Shopify as an API host
# ---------------------------------------------------------------------------
# The canonical headless storefront URL, with scheme and no trailing slash.
# Drives metadataBase and the canonical tag (see lib/site.ts).
#
# Optional on Vercel: when unset, Vercel's own production domain is used,
# which already resolves to the custom domain once one is attached. Set it
# explicitly on any other host, or to pin a domain Vercel does not know about.
SITE_URL=

# ---------------------------------------------------------------------------
# META CONVERSIONS API — server only, never NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Access token for the Relaxonus 1 Pixel (1082533454743448): Events Manager ->
# the dataset -> Settings -> Conversions API -> Generate access token. Mark it
# Sensitive in Vercel. While it is unset, app/api/capi/route.ts accepts the
# browser's beacons and forwards nothing.
META_CAPI_ACCESS_TOKEN=
#
# Optional. The code from Events Manager -> Test events. Server events then
# land in that tab instead of live reporting, so they can be checked first.
# Delete it once they show up deduplicated against the browser events.
META_CAPI_TEST_EVENT_CODE=

# ---------------------------------------------------------------------------
# SHOPIFY ORDER WEBHOOK — server only, never NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Signing secret for the orders/paid webhook that feeds Purchase to the
# Conversions API (app/api/capi/order/route.ts). Shopify admin -> Settings ->
# Notifications -> Webhooks -> create "Order payment", JSON, pointed at
# https://www.relaxonus.com/api/capi/order; the secret is shown on that page.
#
# Every request to that route is rejected unless its HMAC matches this value,
# so a wrong or missing secret means no Purchase events rather than forged
# ones. Mark it Sensitive in Vercel.
SHOPIFY_WEBHOOK_SECRET=
